+// VRAMBridge host calls (see struct ggml_host_call). The call runs on a side stream so device work
+// queued between the call and its join overlaps the host function; everything stays capturable.
+struct ggml_cuda_host_call_state {
+    int device;
+    cudaEvent_t ready;
+    cudaEvent_t done;
+    int * skipped = nullptr;   // mailbox mode
+};
+
+// Mailbox mode (default; GGML_CUDA_HOST_MAILBOX=0 restores cudaLaunchHostFunc): instead of cudaLaunchHostFunc, a one-block kernel writes the inputs into
+// the pinned host buffers, posts the call in a mapped request ring and spins until a persistent host worker marks it
+// done; calls whose miss_src has no zero are posted for bookkeeping only and not waited for. The sequence counter
+// lives in device memory so a captured graph replays correctly.
+#define GGML_CUDA_HOST_RING 1024
+struct ggml_cuda_host_mailbox {
+    volatile uint64_t posted;                    // written by the device: newest request
+    volatile uint64_t done;                      // written by the host: newest finished request
+    ggml_host_call * volatile call[GGML_CUDA_HOST_RING];
+};
+static __device__ uint64_t ggml_cuda_host_seq[GGML_CUDA_MAX_DEVICES];
+struct ggml_cuda_host_worker {
+    ggml_cuda_host_mailbox * box = nullptr;      // host view
+    ggml_cuda_host_mailbox * box_dev = nullptr;  // device view
+    std::thread thread;
+};
+static ggml_cuda_host_worker * ggml_cuda_host_workers[GGML_CUDA_MAX_DEVICES];
+static std::mutex ggml_cuda_host_workers_mutex;
+
+static bool ggml_cuda_host_mailbox_enabled() {
+    static const bool enabled = [] {
+        const char * v = getenv("GGML_CUDA_HOST_MAILBOX");
+        return !v || std::string(v) != "0";
+    }();
+    return enabled;
+}
+
+static void ggml_cuda_host_worker_loop(ggml_cuda_host_mailbox * box) {
+    uint64_t seen = 0;
+    auto idle_since = std::chrono::steady_clock::now();
+    for (;;) {
+        const uint64_t posted = box->posted;
+        if (posted == seen) {
+            // Spin through a generation's gaps; back off once the device has been quiet for a while.
+            if (std::chrono::steady_clock::now() - idle_since > std::chrono::milliseconds(2)) {
+                std::this_thread::sleep_for(std::chrono::microseconds(50));
+            } else {
+#if defined(__x86_64__) || defined(_M_X64)
+                __builtin_ia32_pause();
+#endif
+            }
+            continue;
+        }
+        std::atomic_thread_fence(std::memory_order_acquire);
+        while (seen < posted) {
+            ++seen;
+            ggml_host_call * call = box->call[seen % GGML_CUDA_HOST_RING];
+            call->fn(call->ctx);
+            std::atomic_thread_fence(std::memory_order_seq_cst);
+            box->done = seen;
+        }
+        idle_since = std::chrono::steady_clock::now();
+    }
+}
+
+static ggml_cuda_host_worker * ggml_cuda_host_worker_get(int device) {
+    std::lock_guard<std::mutex> lock(ggml_cuda_host_workers_mutex);
+    if (!ggml_cuda_host_workers[device]) {
+        auto * w = new ggml_cuda_host_worker;
+        CUDA_CHECK(cudaHostAlloc((void **) &w->box, sizeof(ggml_cuda_host_mailbox), cudaHostAllocMapped | cudaHostAllocPortable));
+        memset((void *) w->box, 0, sizeof(ggml_cuda_host_mailbox));
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &w->box_dev, w->box, 0));
