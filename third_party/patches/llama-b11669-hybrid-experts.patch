+
+void llama_moe_cache::hosted_sink_joins(ggml_cgraph * gf) {
+    auto magic = [](const ggml_tensor * t) -> uint64_t {
+        if (t->op != GGML_OP_CUSTOM) return 0;
+        struct { ggml_custom_op_t fun; int n_tasks; void * userdata; } params; // mirrors ggml_custom_op_params
+        static_assert(sizeof(params) <= GGML_MAX_OP_PARAMS, "custom op params");
+        std::memcpy(&params, t->op_params, sizeof(params));
+        if (params.fun != &llama_moe_cache::hosted_unreachable || !params.userdata) return 0;
+        return static_cast<const ggml_host_call *>(params.userdata)->magic;
+    };
+    const int n = ggml_graph_n_nodes(gf);
+    ggml_tensor ** nodes = ggml_graph_nodes(gf);
+    std::vector<ggml_tensor *> independent, dependent;
+    std::unordered_set<const ggml_tensor *> after_join;
+    size_t joins = 0, moved = 0;
+    for (int j = 0; j < n; ++j) {
+        if (magic(nodes[j]) != GGML_HOST_JOIN_MAGIC) continue;
+        int end = j + 1;
+        while (end < n && magic(nodes[end]) != GGML_HOST_CALL_MAGIC) ++end;
+        independent.clear();
+        dependent.assign(1, nodes[j]);
+        after_join.clear();
+        after_join.insert(nodes[j]);
+        for (int k = j + 1; k < end; ++k) {
+            ggml_tensor * t = nodes[k];
+            bool depends = t->view_src && after_join.count(t->view_src);
+            for (int s = 0; s < GGML_MAX_SRC && !depends; ++s) depends = t->src[s] && after_join.count(t->src[s]);
+            if (depends) {
+                after_join.insert(t);
+                dependent.push_back(t);
+            } else {
+                independent.push_back(t);
+            }
+        }
+        ++joins;
+        moved += independent.size();
+        int k = j;
+        for (auto * t : independent) nodes[k++] = t;
+        for (auto * t : dependent) nodes[k++] = t;
+        j = end - 1;
+    }
+    static bool logged = false;
+    if (!logged && joins) {
+        logged = true;
+        LLAMA_LOG_WARN("%s: VRAMBridge hosted joins=%zu; %zu independent nodes now overlap host expert calls\n", __func__, joins, moved);
+    }
+}
