+                const float weight = *reinterpret_cast<const float *>(
+                    static_cast<const char *>(weights->data) + token*weights->nb[2] + rank*weights->nb[1]);
+                const int64_t used = ids->ne[0];
+                const int64_t base = token*used*dst->ne[1];
+                output[base + rank] = slot >= 0 ? -1.0f : float(expert);
+                output[base + used + rank] = slot >= 0 ? float(slot) : float(rank);
+                output[base + 2*used + rank] = slot >= 0 ? 0.0f : weight;
+                output[base + 3*used + rank] = slot >= 0 ? 0.0f : 1.0f;
+            }
+        }
+    }
+
+    // Single-token routing bookkeeping and adaptive admissions for one layer.
+    void admit(layer & l, const std::vector<int> & selected, bool & staging_ready, size_t & staging_used) {
+        auto & g = groups[l.ig];
+        ++dispatch_calls;
+        if (ranked_admission || lru_admission || lfu_admission) for (int key : selected) last_seen[key] = dispatch_calls;
+        if (lfu_admission) {
+            for (int key : selected) lfu_count[key] += lfu_count[key] < lfu_cap;
+            lfu_demands += selected.size();
+            lfu_renewed += selected.size();
+            const double entries = static_cast<double>(std::max<uint64_t>(lfu_entries, 1));
+            const double window = std::min(5.0, 2.0 + 3.0*lfu_renewed/(20.0*entries));
+            if (lfu_demands >= window*entries) {
+                lfu_demands = 0;
+                ++lfu_halvings;
+                for (auto & count : lfu_count) count >>= 1;
+            }
+        }
+        int lfu_inserts = 0;
+        for (int key : selected) {
+            const bool hit = g.lru.slot_map[l.index][expert_keys[key].second] >= 0;
+            pre_admission_hits += hit;
+            if ((payback_profile || probation_admission) && hit) record_admission_reuse(key);
+        }
+        if (adaptive) {
+            history.push_back(selected);
+            for (int key : selected) ++recent[key];
+            if (history.size() > recent_window*routed_layers) {
+                for (int key : history.front()) --recent[key];
+                history.pop_front();
+            }
+            for (int key : selected) {
+                const int expert = expert_keys[key].second;
+                const int margin = probation_admission ? llama_moe_probation_margin(
+                    admission_lifetimes[key].bytes > 0, admission_lifetimes[key].future_hits) : admission_margin;
+                if (g.lru.slot_map[l.index][expert] >= 0) continue;
+                if (lfu_admission ? (lfu_count[key] < std::min(lfu_fill_after, lfu_admit_after) || lfu_inserts >= lfu_inserts_per_layer)
+                                  : recent[key] < margin) continue;
+                int32_t victim_slot = -1;
+                int victim_frequency = 0;
+                if (lfu_admission) {
+                    uint64_t oldest = UINT64_MAX;
+                    for (int32_t slot = g.admission_floor; slot < g.n_slots; ++slot) {
+                        const int victim = g.lru.key_of[slot];
+                        if (victim < 0) { victim_slot = slot; break; }
+                        if (last_seen[victim] >= dispatch_calls) continue; // selected by this dispatch
+                        if (last_seen[victim] < oldest) { oldest = last_seen[victim]; victim_slot = slot; }
+                    }
+                    if (victim_slot < 0) continue;
+                    const int victim = g.lru.key_of[victim_slot];
+                    if (lfu_count[key] < (victim < 0 ? lfu_fill_after : lfu_admit_after)) continue;
+                    if (victim >= 0 && lfu_count[victim] >= lfu_count[key]) continue;
+                    ++lfu_inserts;
+                } else if (lru_admission) {
+                    uint64_t oldest = UINT64_MAX;
+                    for (int32_t slot = g.admission_floor; slot < g.n_slots; ++slot) {
+                        const int victim = g.lru.key_of[slot];
+                        if (victim < 0) { victim_slot = slot; break; }
+                        if (last_seen[victim] >= dispatch_calls) continue; // selected by this dispatch
+                        if (last_seen[victim] < oldest) { oldest = last_seen[victim]; victim_slot = slot; }
+                    }
+                }
+                for (int32_t slot = g.admission_floor; !lru_admission && !lfu_admission && slot < g.n_slots; ++slot) {
+                    const int victim = g.lru.key_of[slot];
+                    if (victim >= 0 && std::find(selected.begin(), selected.end(), victim) != selected.end()) continue;
+                    const int frequency = victim >= 0 ? recent[victim] : 0;
+                    bool prefer_tie = false;
+                    if (ranked_admission && victim_slot >= 0 && victim >= 0 && frequency == victim_frequency) {
+                        const int previous = g.lru.key_of[victim_slot];
+                        prefer_tie = llama_moe_colder_admission(
+                            {frequency, seed_priority[victim], last_seen[victim]},
+                            {victim_frequency, seed_priority[previous], last_seen[previous]});
+                    }
+                    if (victim_slot < 0 || frequency < victim_frequency || prefer_tie) {
+                        victim_slot = slot;
+                        victim_frequency = frequency;
+                        if (victim < 0) break;
+                    }
+                }
+                // Probation strengthens the usual four-read margin after an unproductive observed lifetime.
+                if (victim_slot < 0 || (!lru_admission && !lfu_admission && recent[key] < victim_frequency + margin)) continue;
+                auto backend = devices[g.id].backend;
+                const size_t bytes_before = dynamic_upload_bytes;
+                if (hosted) {
+                    hosted_uploads.push_back({l.index, expert, victim_slot, key});
+                    for (const auto * source : l.experts) dynamic_upload_bytes += expert_stride(source);
+                } else if (!direct_admissions && (!async_admissions || !staging_ready)) {
+                    // Finish prior bank readers and DMA before reusing the staging pool.
+                    ggml_backend_synchronize(backend);
+                    staging_ready = true;
+                }
+                for (size_t ip = 0; !hosted && ip < l.experts.size(); ++ip) {
+                    const auto * source = l.experts[ip];
+                    const size_t stride = expert_stride(source);
+                    if (direct_admissions) {
+                        ggml_backend_tensor_set_async(backend, g.banks[ip],
+                            static_cast<const char *>(source->data) + expert*stride, victim_slot*expert_stride(g.banks[ip]), stride);
+                        dynamic_upload_bytes += stride;
+                        continue;
+                    }
+                    const size_t capacity = ggml_backend_buffer_get_size(admission_staging.get());
+                    for (size_t offset = 0; offset < stride;) {
+                        const size_t count = std::min(stride - offset, capacity);
+                        if (staging_used + count > capacity) {
+                            ggml_backend_synchronize(backend);
+                            staging_used = 0;
+                        }
+                        auto * bytes = static_cast<char *>(ggml_backend_buffer_get_base(admission_staging.get())) + staging_used;
+                        export_expert(source, expert, bytes, count, offset);
+                        if (async_admissions) {
+                            // Finish queued DMA before recycling the bounded pool.
+                            ggml_backend_tensor_set_async(backend, g.banks[ip], bytes, victim_slot*expert_stride(g.banks[ip]) + offset, count);
+                            staging_used += count;
+                        } else {
+                            ggml_backend_tensor_set(g.banks[ip], bytes, victim_slot*expert_stride(g.banks[ip]) + offset, count);
+                        }
+                        offset += count;
+                    }
+                    dynamic_upload_bytes += stride;
+                }
+                const int victim = g.lru.key_of[victim_slot];
+                if (victim >= 0) {
+                    const auto location = expert_keys[victim];
+                    if (payback_profile || probation_admission) {
+                        auto & life = admission_lifetimes[victim];
+                        auto & stats = admission_profiles[location.first];
+                        if (life.dynamic) {
+                            ++stats.evictions;
+                            ++stats.reuse[std::min<uint64_t>(life.future_hits, 4)];
+                            stats.evicted_bytes += life.bytes;
+                            if (!life.future_hits) stats.no_future_bytes += life.bytes;
+                            life.dynamic = false;
+                        } else {
+                            ++stats.seed_evictions;
+                        }
+                    }
+                    g.lru.slot_map[location.first][location.second] = -1;
+                    if (hosted && hosted_visible[location.first][location.second]) {
+                        hosted_visible[location.first][location.second] = 0;
+                        hosted_dirty.insert(location.first);
+                    }
+                }
+                g.lru.key_of[victim_slot] = key;
+                g.lru.slot_map[l.index][expert] = victim_slot;
+                ++dynamic_admissions;
+                if (payback_profile || probation_admission) {
+                    auto & life = admission_lifetimes[key];
+                    GGML_ASSERT(!life.dynamic);
+                    if (life.bytes > 0) {
+                        ++admission_profiles[l.index].readmissions;
+                        if (!life.future_hits) ++admission_profiles[l.index].unreused_readmissions;
+                    }
+                    life = {0, dynamic_upload_bytes - bytes_before, true};
+                    ++admission_profiles[l.index].admissions;
+                }
+            }
+        }
+    }
+
+    void dispatch(ggml_tensor * dst, layer & l) {
+        bool staging_ready = false;
+        size_t staging_used = 0;
+        const auto * ids = dst->src[0];
+        const auto * weights = dst->src[2];
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[0] == l.n_active && ids->ne[1] >= 1 &&
+                    ids->ne[1] <= batch_limit && weights->type == GGML_TYPE_F32 &&
+                    weights->ne[2] == ids->ne[1]);
+        if (ids->ne[1] > 1) {
+            ++dispatch_calls;
+            // No slot may be evicted while any position of this block still needs it.
+            write_dispatch(dst, l, true);
+            return;
+        }
+        std::vector<int> selected(l.n_active);
+        for (int rank = 0; rank < l.n_active; ++rank) {
+            const int32_t expert = *reinterpret_cast<const int32_t *>(
+                static_cast<const char *>(ids->data) + rank*ids->nb[0]);
+            GGML_ASSERT(expert >= 0 && expert < l.n_expert);
+            selected[rank] = l.key_offset + expert;
+        }
+        admit(l, selected, staging_ready, staging_used);
+        auto & g = groups[l.ig];
+        int cold_rank = -1;
+        if (cold_gpu) {
+            int misses = 0;
+            for (int rank = 0; rank < l.n_active; ++rank) {
+                if (g.lru.slot_map[l.index][expert_keys[selected[rank]].second] < 0) {
+                    ++misses;
+                    cold_rank = rank;
+                }
+            }
+            if (llama_moe_cold_gpu_budget(misses)) {
+                const int expert = expert_keys[selected[cold_rank]].second;
+                auto backend = devices[g.id].backend;
+                // The shared scratch slot is outside residency. Same-stream ordering protects prior readers.
+                for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                    const auto * source = l.experts[ip];
+                    const size_t stride = expert_stride(source);
+                    const auto * bytes = static_cast<const char *>(source->data) + expert*stride;
+                    const size_t offset = g.n_slots*expert_stride(g.banks[ip]);
+                    if (cold_sync) {
+                        ggml_backend_tensor_set(g.banks[ip], bytes, offset, stride);
+                    } else {
+                        ggml_backend_tensor_set_async(backend, g.banks[ip], bytes, offset, stride);
+                    }
+                    cold_gpu_bytes += stride;
+                }
+                ++cold_gpu_calls;
+            } else {
+                cold_rank = -1;
+            }
+        }
+        write_dispatch(dst, l, false, cold_rank);
+    }
+
+    void record_admission_reuse(int key) {
+        auto & life = admission_lifetimes[key];
+        if (life.dynamic) {
+            ++life.future_hits;
+            ++admission_profiles[expert_keys[key].first].future_hits;
+        }
+    }
