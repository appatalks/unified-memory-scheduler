+    }
+    const int64_t blocks = tensor->ne[0] / QK_MXFP4;
+    const auto * packed = reinterpret_cast<const block_mxfp4x8 *>(
+        static_cast<const char *>(tensor->data) + expert*tensor->nb[2]);
+    auto * raw = static_cast<block_mxfp4 *>(output);
+    for (int64_t row = 0; row < tensor->ne[1]; row += 8) {
+        for (int64_t block = 0; block < blocks; ++block) {
+            const auto & group = packed[(row/8)*blocks + block];
+            for (int r = 0; r < 8; ++r) {
+                auto & result = raw[(row + r)*blocks + block];
+                result.e = group.e[r];
+                for (int chunk = 0; chunk < 2; ++chunk) {
+                    std::memcpy(result.qs + chunk*8, group.qs + (chunk*8 + r)*8, 8);
+                }
+            }
+        }
+    }
