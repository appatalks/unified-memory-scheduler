+    int          n_src;
+    const int32_t * miss;      // nullptr: always wait
+    int64_t      n_miss;
+    ggml_host_call * call;
+    ggml_cuda_host_mailbox * box;
+    int          device;
+    int        * skipped;      // device flag for the copy-back kernel
+};
+
+static __device__ __forceinline__ void ggml_cuda_host_copy_bytes(char * dst, const char * src, int64_t n) {
+    if ((((uintptr_t) dst | (uintptr_t) src | (uintptr_t) n) & 15) == 0) {
+        for (int64_t i = threadIdx.x; i < n/16; i += blockDim.x) {
+            ((int4 *) dst)[i] = ((const int4 *) src)[i];
+        }
+    } else {
+        for (int64_t i = threadIdx.x; i < n; i += blockDim.x) {
+            dst[i] = src[i];
+        }
+    }
+}
+
+static __global__ void ggml_cuda_host_call_post(const ggml_cuda_host_call_args a) {
+    int miss = a.miss == nullptr;
+    for (int64_t i = threadIdx.x; !miss && i < a.n_miss; i += blockDim.x) {
+        miss = a.miss[i] == 0;
+    }
+    miss = __syncthreads_or(miss);
+    for (int s = 0; s < a.n_src; ++s) {
+        ggml_cuda_host_copy_bytes(a.src_host[s], a.src[s], a.src_bytes[s]);
+    }
+    __threadfence_system();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        const uint64_t seq = ++ggml_cuda_host_seq[a.device];
+        a.box->call[seq % GGML_CUDA_HOST_RING] = a.call;
+        __threadfence_system();
+        a.box->posted = seq;
+        *a.skipped = !miss;
+        if (miss) {
+            while (a.box->done < seq) {
+                __nanosleep(256);
+            }
+        }
+        __threadfence_system();
+    }
+}
+
+static __global__ void ggml_cuda_host_call_fetch(const int4 * host, int4 * dst, const int64_t n, const int * skipped) {
+    const bool zero = *skipped;
+    for (int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x*blockDim.x) {
+        dst[i] = zero ? make_int4(0, 0, 0, 0) : host[i];
+    }
+}
+
+static ggml_host_call * ggml_cuda_host_call_desc(const ggml_tensor * op, uint64_t magic) {
+    if (op->op != GGML_OP_CUSTOM) {
+        return nullptr;
+    }
+    ggml_custom_op_params params;
+    memcpy(&params, op->op_params, sizeof(params));
+    auto * desc = static_cast<ggml_host_call *>(params.userdata);
+    return desc && desc->magic == magic ? desc : nullptr;
+}
+
+static bool ggml_cuda_host_call_supported(const ggml_tensor * op) {
+    if (ggml_host_call * call = ggml_cuda_host_call_desc(op, GGML_HOST_CALL_MAGIC)) {
+        if (!ggml_is_contiguous(op) || !call->dst_host) {
+            return false;
+        }
+        for (int i = 0; i < GGML_MAX_SRC && op->src[i]; ++i) {
+            if (!ggml_is_contiguous(op->src[i]) || !call->src_host[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+    if (ggml_cuda_host_call_desc(op, GGML_HOST_JOIN_MAGIC)) {
+        const ggml_tensor * a = op->src[0];
+        const ggml_tensor * b = op->src[1];
+        return a && b && op->type == GGML_TYPE_F32 && a->type == GGML_TYPE_F32 && b->type == GGML_TYPE_F32 &&
+            ggml_is_contiguous(op) && ggml_is_contiguous(a) && ggml_is_contiguous(b) &&
+            ggml_are_same_shape(op, a) && ggml_are_same_shape(op, b);
+    }
+    return false;
+}
+
+static cudaStream_t ggml_cuda_host_call_stream(int device) {
+    static cudaStream_t streams[GGML_CUDA_MAX_DEVICES] = {};
+    if (!streams[device]) {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&streams[device], cudaStreamNonBlocking));
+    }
+    return streams[device];
+}
+
+static void CUDART_CB ggml_cuda_host_call_trampoline(void * data) {
+    auto * call = static_cast<ggml_host_call *>(data);
+    call->fn(call->ctx);
+}
+
+static void ggml_cuda_host_call(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_host_call * call = ggml_cuda_host_call_desc(dst, GGML_HOST_CALL_MAGIC);
+    GGML_ASSERT(call);
+    auto * state = static_cast<ggml_cuda_host_call_state *>(call->backend_state);
+    if (!state) {
+        state = new ggml_cuda_host_call_state{ctx.device, nullptr, nullptr};
+        CUDA_CHECK(cudaEventCreateWithFlags(&state->ready, cudaEventDisableTiming));
+        CUDA_CHECK(cudaEventCreateWithFlags(&state->done, cudaEventDisableTiming));
+        call->backend_state = state;
+    }
+    GGML_ASSERT(state->device == ctx.device);
+    cudaStream_t main = ctx.stream();
+    cudaStream_t side = ggml_cuda_host_call_stream(ctx.device);
+    CUDA_CHECK(cudaEventRecord(state->ready, main));
+    CUDA_CHECK(cudaStreamWaitEvent(side, state->ready, 0));
+    if (ggml_cuda_host_mailbox_enabled()) {
+        ggml_cuda_host_worker * w = ggml_cuda_host_worker_get(ctx.device);
+        if (!state->skipped) {
+            CUDA_CHECK(cudaMalloc((void **) &state->skipped, sizeof(int)));
+        }
+        ggml_cuda_host_call_args a = {};
+        for (int i = 0; i < GGML_MAX_SRC && dst->src[i]; ++i) {
+            GGML_ASSERT(i < 4 && "mailbox host calls take at most 4 inputs");
+            a.src[i] = (const char *) dst->src[i]->data;
+            CUDA_CHECK(cudaHostGetDevicePointer((void **) &a.src_host[i], call->src_host[i], 0));
+            a.src_bytes[i] = ggml_nbytes(dst->src[i]);
+            a.n_src = i + 1;
+        }
+        if (call->miss_src > 0) {
+            const ggml_tensor * miss = dst->src[call->miss_src - 1];
+            GGML_ASSERT(miss && miss->type == GGML_TYPE_I32);
+            a.miss = (const int32_t *) miss->data;
+            a.n_miss = ggml_nelements(miss);
+        }
+        a.call = call;
+        a.box = w->box_dev;
+        a.device = ctx.device;
+        a.skipped = state->skipped;
+        ggml_cuda_host_call_post<<<1, 256, 0, side>>>(a);
+        CUDA_CHECK(cudaGetLastError());
+        const int64_t n = ggml_nbytes(dst);
+        GGML_ASSERT(n % 16 == 0 && ((uintptr_t) dst->data & 15) == 0 && ((uintptr_t) call->dst_host & 15) == 0);
+        const int4 * host = nullptr;
+        CUDA_CHECK(cudaHostGetDevicePointer((void **) &host, call->dst_host, 0));
+        const int blocks = (int) std::min<int64_t>(64, (n/16 + 255)/256);
+        ggml_cuda_host_call_fetch<<<std::max(blocks, 1), 256, 0, side>>>(host, (int4 *) dst->data, n/16, state->skipped);
+        CUDA_CHECK(cudaGetLastError());
+        CUDA_CHECK(cudaEventRecord(state->done, side));
+        return;
+    }
+    for (int i = 0; i < GGML_MAX_SRC && dst->src[i]; ++i) {
+        CUDA_CHECK(cudaMemcpyAsync(call->src_host[i], dst->src[i]->data, ggml_nbytes(dst->src[i]), cudaMemcpyDeviceToHost, side));
+    }
+    CUDA_CHECK(cudaLaunchHostFunc(side, ggml_cuda_host_call_trampoline, call));
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, call->dst_host, ggml_nbytes(dst), cudaMemcpyHostToDevice, side));
+    CUDA_CHECK(cudaEventRecord(state->done, side));
+}
+
+static __global__ void ggml_cuda_host_join_kernel(const float * a, const float * b, float * dst, const int64_t n) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i < n) {
+        dst[i] = a[i] + b[i];
+    }
+}
+
+static void ggml_cuda_host_join(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_host_call * join = ggml_cuda_host_call_desc(dst, GGML_HOST_JOIN_MAGIC);
+    GGML_ASSERT(join && join->call);
+    auto * state = static_cast<ggml_cuda_host_call_state *>(join->call->backend_state);
+    GGML_ASSERT(state && state->device == ctx.device && "host-call join scheduled before its call");
+    cudaStream_t main = ctx.stream();
+    CUDA_CHECK(cudaStreamWaitEvent(main, state->done, 0));
