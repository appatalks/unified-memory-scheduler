+static bool vrambridge_expert_domain(const ggml_cgraph & graph, bool host, ggml_backend_dev_t device) {
+    bool expert = false;
+    const char * prefix = host ? "hybrid_cpu_" : "hybrid_gpu_";
+    for (int i = 0; i < graph.n_nodes; ++i) {
+        const auto * node = graph.nodes[i];
+        if (!vrambridge_pure_expert_op(node->op) || !vrambridge_tensor_domain(node, host, device)) return false;
+        if (host && ggml_backend_buffer_get_usage(node->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) return false;
+        expert = expert || strncmp(node->name, prefix, strlen(prefix)) == 0;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            if (node->src[j] && !vrambridge_tensor_domain(node->src[j], host, device)) return false;
+        }
+    }
+    return expert;
+}
