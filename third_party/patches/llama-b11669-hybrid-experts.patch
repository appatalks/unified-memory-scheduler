+void llama_moe_cache::hybrid_upload_ids(ggml_tensor * dst, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    auto & layer = *static_cast<impl::layer *>(userdata);
+    auto & owner = *layer.owner;
+    const auto * packed = dst->src[0];
+    GGML_ASSERT(layer.device_ids && layer.id_event && owner.id_staging);
+    GGML_ASSERT(dst->type == GGML_TYPE_I32 && dst->ne[0] == layer.n_active &&
+                dst->ne[1] > 0 && dst->ne[1] <= owner.batch_limit && dst->ne[2] == 1 && dst->ne[3] == 1);
+    GGML_ASSERT(packed->type == GGML_TYPE_F32 && packed->ne[0] == layer.n_active &&
+                packed->ne[1] == (owner.route_packet ? 6 : 4) &&
+                packed->ne[2] == dst->ne[1] && packed->ne[3] == 1);
+    if (layer.ids_uploaded) ggml_backend_event_synchronize(layer.id_event.get());
+    auto * staging = reinterpret_cast<int32_t *>(
+        static_cast<char *>(ggml_backend_buffer_get_base(owner.id_staging.get())) + layer.id_staging_offset);
+    for (int64_t token = 0; token < dst->ne[1]; ++token) {
+        for (int64_t rank = 0; rank < dst->ne[0]; ++rank) {
+            const float value = *reinterpret_cast<const float *>(
+                static_cast<const char *>(packed->data) + token*packed->nb[2] + packed->nb[1] + rank*packed->nb[0]);
+            GGML_ASSERT(std::isfinite(value) && value >= 0 &&
+                        value < llama_moe_gpu_slot_limit(owner.groups[layer.ig].n_slots, owner.cold_gpu));
+            const auto id = static_cast<int32_t>(value);
+            GGML_ASSERT(value == static_cast<float>(id));
+            staging[token*dst->ne[0] + rank] = id;
+        }
+    }
+    const auto backend = owner.devices[owner.groups[layer.ig].id].backend;
+    // Private storage is outside graph scratch. The same stream orders ID uploads before their GPU consumers.
+    ggml_backend_tensor_set_async(backend, dst, staging, 0, ggml_nbytes(dst));
+    ggml_backend_event_record(layer.id_event.get(), backend);
+    layer.ids_uploaded = true;
+    ++owner.id_uploads;
+    owner.id_upload_bytes += ggml_nbytes(dst);
+}
