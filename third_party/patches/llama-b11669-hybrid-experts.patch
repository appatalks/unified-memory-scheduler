+    // VRAMBridge host call: a GGML_OP_CUSTOM node whose userdata points to this descriptor.
+    // A backend that supports it copies each contiguous src into src_host[i], runs fn(ctx) on a host thread
+    // and copies dst_host into dst, ordered inside the backend's stream (so it can be captured in a device graph).
+    // A host-call join node (GGML_HOST_JOIN_MAGIC) computes dst = src[0] + src[1] after the call it names completes.
+    // fn must not call device APIs.
+#define GGML_HOST_CALL_MAGIC 0x56424843414c4c31ULL /* "VBHCALL1" */
+#define GGML_HOST_JOIN_MAGIC 0x5642484a4f494e31ULL /* "VBHJOIN1" */
+    struct ggml_host_call {
+        uint64_t magic;
+        void  (*fn)(void * ctx);
+        void   * ctx;
+        void   * src_host[GGML_MAX_SRC];
+        void   * dst_host;
+        void   * backend_state;           // owned by the executing backend
+        struct ggml_host_call * call;     // join nodes: the call they wait for
+        // calls: 0, or k > 0 when src[k-1] is I32 and the call has work only if one of its values is 0. A backend
+        // may then skip waiting for fn and zero dst instead; fn still runs (for bookkeeping) before the backend's
+        // next synchronize returns, and must not rely on dst reaching the device in that case.
+        int32_t miss_src;
+    };
