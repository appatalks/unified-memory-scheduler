+struct source_registration {
+    using register_fn = bool (*)(void *, size_t);
+    using unregister_fn = void (*)(void *);
+    unregister_fn unregister_pages = nullptr;
+    std::vector<std::pair<uintptr_t, uintptr_t>> registered;
+    source_registration() = default;
+    source_registration(const source_registration &) = delete;
+    source_registration & operator=(const source_registration &) = delete;
+
+    ~source_registration() {
+        for (const auto & range : registered) unregister_pages(reinterpret_cast<void *>(range.first));
+    }
+
+    static uint64_t available_ram() {
+        std::ifstream info("/proc/meminfo");
+        std::string name, line;
+        uint64_t value;
+        while (info >> name >> value) {
+            std::getline(info, line);
+            if (name == "MemAvailable:") return value*1024;
+        }
+        throw std::runtime_error("Cannot read MemAvailable for bounded source registration");
+    }
+
+    void pin(ggml_backend_t backend, const std::vector<const ggml_tensor *> & sources) {
+#if defined(__linux__)
+        const char * enabled = std::getenv("GGML_CUDA_REGISTER_HOST");
+        if (!enabled || std::string(enabled) != "1") {
+            throw std::runtime_error("Direct admissions require GGML_CUDA_REGISTER_HOST=1");
+        }
+        const auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+        const auto register_pages = reinterpret_cast<register_fn>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer"));
+        unregister_pages = reinterpret_cast<unregister_fn>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer"));
+        if (!register_pages || !unregister_pages) throw std::runtime_error("Read-only CUDA host-registration hooks unavailable");
+        const long page_size = sysconf(_SC_PAGESIZE);
+        if (page_size <= 0) throw std::runtime_error("Cannot determine registration page size");
+        const auto page = static_cast<uintptr_t>(page_size);
+        std::vector<std::pair<uintptr_t, uintptr_t>> ranges;
+        for (const auto * tensor : sources) {
+            if (!llama_moe_cache_is_host_weight(tensor) || is_cpu_repacked(tensor) ||
+                std::string(ggml_backend_buft_name(ggml_backend_buffer_get_type(tensor->buffer))).find("CUDA") != std::string::npos) {
+                throw std::runtime_error("Direct admissions require raw, not already CUDA-pinned host weights");
+            }
+            const auto address = reinterpret_cast<uintptr_t>(tensor->data);
+            const auto bytes = ggml_nbytes(tensor);
+            if (!address || bytes > std::numeric_limits<uintptr_t>::max() - page ||
+                address > std::numeric_limits<uintptr_t>::max() - bytes - page) {
+                throw std::runtime_error("Invalid source-registration range");
+            }
+            ranges.emplace_back(address/page*page, (address + bytes + page - 1)/page*page);
+        }
+        std::sort(ranges.begin(), ranges.end());
+        std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+        for (const auto & range : ranges) {
+            if (merged.empty() || range.first > merged.back().second) merged.push_back(range);
+            else merged.back().second = std::max(merged.back().second, range.second);
+        }
+        constexpr uint64_t cap = uint64_t(64) << 30;
+        constexpr uint64_t headroom = uint64_t(24) << 30;
+        uint64_t total = 0;
+        for (const auto & range : merged) {
+            const uint64_t bytes = range.second - range.first;
+            if (bytes > cap - total) throw std::runtime_error("Source registration exceeds 64 GiB cap");
+            total += bytes;
+        }
+        if (!total || available_ram() < total + headroom) {
+            throw std::runtime_error("Source registration exceeds 64 GiB cap or 24 GiB available-RAM headroom");
+        }
+        registered.reserve(merged.size());
+        for (const auto & range : merged) {
+            if (!register_pages(reinterpret_cast<void *>(range.first), range.second - range.first)) {
+                throw std::runtime_error("Read-only source registration failed; unwinding successful registrations");
+            }
+            registered.push_back(range);
+        }
+        if (available_ram() < headroom) throw std::runtime_error("Insufficient RAM headroom after source registration");
+        LLAMA_LOG_WARN("%s: registered %llu immutable source bytes in %zu ranges; cap 64 GiB, headroom 24 GiB\n",
+                       __func__, static_cast<unsigned long long>(total), registered.size());
+#else
+        (void) backend;
+        (void) sources;
+        throw std::runtime_error("Direct source registration currently requires Linux");
+#endif
+    }
