+        w->thread = std::thread(ggml_cuda_host_worker_loop, w->box);
+        w->thread.detach();
+        ggml_cuda_host_workers[device] = w;
+        GGML_LOG_INFO("%s: CUDA%d host-call mailbox worker started\n", __func__, device);
+    }
+    return ggml_cuda_host_workers[device];
+}
+
+// Returns once every request posted to the device's mailbox has been handled (call after the stream is idle).
