+bool ggml_backend_cpu_repack_export_expert(const ggml_tensor * tensor, int64_t expert, void * output, size_t bytes) {
+    if (!tensor || !tensor->buffer || tensor->buffer->buft != ggml_backend_cpu_repack_buffer_type() ||
+        tensor->type != GGML_TYPE_MXFP4 || !ggml_cpu_has_avx2() ||
+        tensor->ne[1] % 8 || tensor->ne[0] % QK_MXFP4 || tensor->ne[3] != 1 ||
+        expert < 0 || expert >= tensor->ne[2] || bytes != tensor->nb[2] || !output || !tensor->data ||
+        tensor->extra != ggml_repack_get_optimal_repack_type(tensor) ||
+        !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const int64_t blocks = tensor->ne[0] / QK_MXFP4;
+    const auto * packed = reinterpret_cast<const block_mxfp4x8 *>(
+        static_cast<const char *>(tensor->data) + expert*tensor->nb[2]);
+    auto * raw = static_cast<block_mxfp4 *>(output);
+    for (int64_t row = 0; row < tensor->ne[1]; row += 8) {
+        for (int64_t block = 0; block < blocks; ++block) {
+            const auto & group = packed[(row/8)*blocks + block];
+            for (int r = 0; r < 8; ++r) {
+                auto & result = raw[(row + r)*blocks + block];
+                result.e = group.e[r];
+                for (int chunk = 0; chunk < 2; ++chunk) {
+                    std::memcpy(result.qs + chunk*8, group.qs + (chunk*8 + r)*8, 8);
+                }
+            }
+        }
+    }
+    return true;
+}
