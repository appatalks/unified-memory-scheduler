+void llama_moe_cache::hybrid_dispatch(ggml_tensor * dst, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    auto * state = static_cast<impl::layer *>(userdata);
+    if (state->owner->route_packet) {
+        const auto * packet = dst->src[0];
+        const int64_t active = state->n_active;
+        const int64_t tokens = packet->ne[1];
+        GGML_ASSERT(packet->type == GGML_TYPE_F32 && packet->ne[0] == 2*active &&
+                    packet->ne[2] == 1 && packet->ne[3] == 1 && tokens > 0 &&
+                    tokens <= state->owner->batch_limit && active*tokens <= static_cast<int64_t>(state->packet_ids.size()));
+        for (int64_t token = 0; token < tokens; ++token) {
+            for (int64_t rank = 0; rank < active; ++rank) {
+                const float value = *reinterpret_cast<const float *>(
+                    static_cast<const char *>(packet->data) + token*packet->nb[1] + rank*packet->nb[0]);
+                GGML_ASSERT(std::isfinite(value) && value >= 0 && value < state->n_expert && value == std::floor(value));
+                state->packet_ids[token*active + rank] = static_cast<int32_t>(value);
+            }
+        }
+        ggml_tensor ids = {};
+        ids.type = GGML_TYPE_I32;
+        ids.data = state->packet_ids.data();
+        ids.ne[0] = active; ids.ne[1] = tokens; ids.ne[2] = ids.ne[3] = 1;
+        ids.nb[0] = sizeof(int32_t); ids.nb[1] = active*ids.nb[0];
+        ids.nb[2] = ids.nb[3] = tokens*ids.nb[1];
+        ggml_tensor weights = {};
+        weights.type = GGML_TYPE_F32;
+        weights.data = static_cast<char *>(packet->data) + active*packet->nb[0];
+        weights.ne[0] = 1; weights.ne[1] = active; weights.ne[2] = tokens; weights.ne[3] = 1;
+        weights.nb[0] = sizeof(float); weights.nb[1] = packet->nb[0];
+        weights.nb[2] = packet->nb[1]; weights.nb[3] = tokens*weights.nb[2];
+        ggml_tensor routed = *dst;
+        routed.src[0] = &ids;
+        routed.src[2] = &weights;
+        state->owner->dispatch(&routed, *state);
+        GGML_ASSERT(dst->ne[1] == 6);
+        auto * output = static_cast<float *>(dst->data);
+        for (int64_t token = 0; token < tokens; ++token) {
+            for (int64_t rank = 0; rank < active; ++rank) {
+                output[token*active*6 + 4*active + rank] = static_cast<float>(state->packet_ids[token*active + rank]);
+                output[token*active*6 + 5*active + rank] = *reinterpret_cast<const float *>(
+                    static_cast<const char *>(weights.data) + token*weights.nb[2] + rank*weights.nb[1]);
+            }
+        }
+        ++state->owner->route_packets;
+        state->owner->route_packet_bytes += ggml_nbytes(packet);
+        return;
+    }
+    state->owner->dispatch(dst, *state);
+}
