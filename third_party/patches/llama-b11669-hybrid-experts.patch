 #include "ggml-backend.h"
 
+#include <algorithm>
 #include <map>
 #include <memory>
 #include <vector>
 
 struct llama_model;
 
+struct llama_moe_admission_rank {
+    int frequency;
+    int seed_priority;
+    uint64_t last_seen;
+};
+
+inline bool llama_moe_colder_admission(llama_moe_admission_rank candidate, llama_moe_admission_rank current) {
+    if (candidate.frequency != current.frequency) return candidate.frequency < current.frequency;
+    if (candidate.frequency == 0 && candidate.seed_priority != current.seed_priority) {
+        return candidate.seed_priority < current.seed_priority;
+    }
+    return candidate.last_seen < current.last_seen;
+}
+
+inline int llama_moe_probation_margin(bool observed_lifetime, uint64_t future_hits) {
+    return 4 + (observed_lifetime && future_hits < 3 ? 3 - static_cast<int>(future_hits) : 0);
+}
+
+inline int llama_moe_anchor_slots(int capacity, int reserved, int seeds) {
+    GGML_ASSERT(capacity >= reserved && seeds >= 0 && seeds <= capacity - reserved);
+    return std::min(seeds, (capacity - reserved)/4);
+}
+
+inline int llama_moe_cold_gpu_budget(int cold_experts) {
+    GGML_ASSERT(cold_experts >= 0);
+    return cold_experts >= 2 ? 1 : 0;
+}
+
+inline int32_t llama_moe_gpu_slot_limit(int32_t resident_slots, bool cold_gpu) {
+    GGML_ASSERT(resident_slots > 0 && resident_slots < INT32_MAX);
+    return resident_slots + (cold_gpu ? 1 : 0);
+}
+
