+static bool vrambridge_tensor_domain(const ggml_tensor * tensor, bool host, ggml_backend_dev_t device) {
+    if (!tensor || !tensor->buffer || !tensor->data) return false;
+    if (ggml_backend_buffer_is_host(tensor->buffer) != host) return false;
+    if (!host && ggml_backend_buft_get_device(ggml_backend_buffer_get_type(tensor->buffer)) != device) return false;
+    for (const ggml_tensor * view = tensor->view_src; view; view = view->view_src) {
+        if (view->buffer != tensor->buffer) return false;
+    }
+    return true;
+}
