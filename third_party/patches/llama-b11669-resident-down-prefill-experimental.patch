+        maximum = std::max(maximum, std::abs(delta));
+        scale = std::max(scale, std::abs(double(b[i])));
+        delta2 += delta * delta;
+        norm2 += double(b[i]) * b[i];
+    }
+    const double relative = std::sqrt(delta2 / std::max(norm2, 1e-30));
+    ++layer.prefill_audit_calls;
+    layer.prefill_audit_failures += maximum > 0.00001 + 0.0001 * scale || relative > 0.0001;
+    layer.prefill_audit_abs = std::max(layer.prefill_audit_abs, maximum);
+    layer.prefill_audit_l2 = std::max(layer.prefill_audit_l2, relative);
+    std::memmove(dst->data, actual->data, ggml_nbytes(actual));
+}
