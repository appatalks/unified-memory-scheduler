+                const bool owner_continuing = prefill_owner && prefill_owner->state == SLOT_STATE_PROCESSING_PROMPT;
+                if (!prefill_owner || (continuing && !owner_continuing) ||
+                    (continuing == owner_continuing && candidate.task->id < prefill_owner->task->id)) {
+                    prefill_owner = &candidate;
+                }
+            }
+        }
+
