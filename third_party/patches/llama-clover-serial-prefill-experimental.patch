         // start populating the batch for this iteration
         batch.clear();
 
+        server_slot * prefill_owner = nullptr;
+        const char * prefill_env = std::getenv("VRAMBRIDGE_EXPERIMENT_SERIAL_PREFILL");
+        if (prefill_env && std::strcmp(prefill_env, "0") != 0 && std::strcmp(prefill_env, "1") != 0) {
+            throw std::runtime_error("VRAMBRIDGE_EXPERIMENT_SERIAL_PREFILL must be 0 or 1");
+        }
+        const bool isolated_prefill = prefill_env && std::strcmp(prefill_env, "1") == 0;
+        if (isolated_prefill) {
