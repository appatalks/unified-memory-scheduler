+                std::any_of(params_base.speculative.types.begin(), params_base.speculative.types.end(),
+                            [](auto type) { return type != COMMON_SPECULATIVE_TYPE_NONE; })) {
+                throw std::runtime_error("Experimental serial prefill requires causal, non-speculative execution");
+            }
+            for (auto & candidate : slots) {
+                if (candidate.state != SLOT_STATE_STARTED && candidate.state != SLOT_STATE_PROCESSING_PROMPT) continue;
