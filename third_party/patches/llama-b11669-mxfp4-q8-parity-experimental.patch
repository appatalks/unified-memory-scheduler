 #include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+bool ggml_cuda_mxfp4_cpu_q8_parity() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("VRAMBRIDGE_HYBRID_MXFP4_Q8_PARITY");
+        if (!value || std::strcmp(value, "0") == 0) {
+            return false;
+        }
+        if (std::strcmp(value, "1") != 0) {
+            GGML_ABORT("VRAMBRIDGE_HYBRID_MXFP4_Q8_PARITY must be 0 or 1");
+        }
+        GGML_LOG_WARN("VRAMBridge experimental MXFP4 CPU-Q8 activation parity enabled; original weights unchanged\n");
+        return true;
+    }();
+    return enabled;
+}
+
+static __device__ __forceinline__ int8_t quantize_cpu_q8_code(float value, float amax) {
+    const float inverse = amax > 0.0f ? __fdiv_rn(127.0f, amax) : 0.0f;
+    return static_cast<int8_t>(__float2int_rn(__fmul_rn(value, inverse)));
+}
 
