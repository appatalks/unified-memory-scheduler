[global]
rw=read
bs=1M
direct=1
ioengine=libaio
time_based=1
runtime=4
ramp_time=1
size=8G
offset=4G
numjobs=1
allow_file_create=0
stonewall=1
group_reporting=1

[wd-qd1-r1]
filename=/dev/nvme0n1p1
iodepth=1

[samsung-qd1-r1]
filename=/dev/nvme1n1p3
iodepth=1

[samsung-qd1-r2]
filename=/dev/nvme1n1p3
iodepth=1

[wd-qd1-r2]
filename=/dev/nvme0n1p1
iodepth=1

[wd-qd1-r3]
filename=/dev/nvme0n1p1
iodepth=1

[samsung-qd1-r3]
filename=/dev/nvme1n1p3
iodepth=1

[samsung-qd16-r1]
filename=/dev/nvme1n1p3
iodepth=16

[wd-qd16-r1]
filename=/dev/nvme0n1p1
iodepth=16

[wd-qd16-r2]
filename=/dev/nvme0n1p1
iodepth=16

[samsung-qd16-r2]
filename=/dev/nvme1n1p3
iodepth=16

[samsung-qd16-r3]
filename=/dev/nvme1n1p3
iodepth=16

[wd-qd16-r3]
filename=/dev/nvme0n1p1
iodepth=16
