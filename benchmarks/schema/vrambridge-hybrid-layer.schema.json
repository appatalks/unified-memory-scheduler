{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrambridge.dev/schema/hybrid-layer-v1.json",
  "title": "VRAMBridge isolated hybrid expert execution probe",
  "type": "object",
  "required": ["schema_version", "backend_commit", "probe_source_sha256", "weights", "activation_source", "routing_weights", "selected_weight_bytes", "full_model_acceleration_claim", "warm_cache_microbenchmark", "hardware_gpu_partition", "partitions", "all_checks_passed", "limitations"],
  "$defs": {
    "comparison": {
      "type": "object",
      "required": ["max_abs_error", "relative_l2_error", "reference_max_abs", "passed", "tolerance"],
      "properties": {
        "max_abs_error": {"type": "number", "minimum": 0},
        "relative_l2_error": {"type": "number", "minimum": 0},
        "reference_max_abs": {"type": "number", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "q8_comparison": {
      "type": "object",
      "required": ["blocks", "different_scale_blocks", "different_code_blocks", "different_code_values", "effective_value_error"],
      "properties": {
        "blocks": {"type": "integer", "minimum": 1},
        "different_scale_blocks": {"type": "integer", "minimum": 0},
        "different_code_blocks": {"type": "integer", "minimum": 0},
        "different_code_values": {"type": "integer", "minimum": 0},
        "effective_value_error": {"$ref": "#/$defs/comparison"}
      }
    },
    "timing": {
      "type": "object",
      "required": ["median_ms", "min_ms", "samples_ms", "worst_max_abs_error", "worst_relative_l2_error"],
      "properties": {
        "median_ms": {"type": "number", "exclusiveMinimum": 0},
        "min_ms": {"type": "number", "exclusiveMinimum": 0},
        "samples_ms": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "worst_max_abs_error": {"type": "number", "minimum": 0},
        "worst_relative_l2_error": {"type": "number", "minimum": 0},
        "median_cpu_activation_prepare_ms": {"type": "number", "minimum": 0},
        "median_activation_stage_copy_ms": {"type": "number", "minimum": 0},
        "all_checks_passed": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "probe_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "weights": {"enum": ["real_gptoss_mxfp4", "synthetic_f32"]},
    "activation_source": {"const": "deterministic synthetic"},
    "routing_weights": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "selected_weight_bytes": {"type": "integer", "minimum": 1},
    "full_model_acceleration_claim": {"const": false},
    "warm_cache_microbenchmark": {"type": "boolean"},
    "rows_per_expert": {"type": "integer", "minimum": 1, "maximum": 256},
    "gpu_row_limit": {"type": "integer", "minimum": 0, "maximum": 256},
    "cpu_row_limit": {"type": "integer", "minimum": 0, "maximum": 256},
    "execution_split": {"enum": ["whole_experts", "cpu_activation_gpu_down"]},
    "cpu_activation_quantization": {"enum": ["none", "native_q8_0_roundtrip_to_f32"]},
    "activation_stage_copy_method": {"enum": ["none", "synchronous_tensor_copy"]},
    "activation_stage_copy_destination": {"enum": ["cpu_self_test", "gpu"]},
    "activation_pattern": {"enum": ["sine", "zero", "q8-ties"]},
    "selected_expert_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
    "mxfp4_cpu_q8_parity": {"enum": [null, "0", "1"]},
    "operator_check_enabled": {"type": "boolean"},
    "timings_qualified": {"type": "boolean"},
    "operator_diagnostics": {
      "type": "object",
      "required": ["raw_activations_recorded", "performance_measurement", "candidate_backend", "samples", "all_checks_passed"],
      "properties": {
        "raw_activations_recorded": {"const": false},
        "performance_measurement": {"const": false},
        "candidate_backend": {"enum": ["cpu_self_test", "gpu"]},
        "all_checks_passed": {"type": "boolean"},
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["sample", "cpu_observer_control", "gpu_observer_control", "uninstrumented_cpu_gpu", "chained_operator_checks"],
            "properties": {
              "sample": {"type": "integer", "minimum": 0},
              "cpu_observer_control": {"$ref": "#/$defs/comparison"},
              "gpu_observer_control": {"$ref": "#/$defs/comparison"},
              "cpu_activation_observer_control": {"$ref": "#/$defs/comparison"},
              "uninstrumented_cpu_gpu": {"$ref": "#/$defs/comparison"},
              "cpu_output_fnv1a64": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "gpu_output_fnv1a64": {"type": "string", "pattern": "^[0-9]{1,20}$"},
              "cpu_effective_q8_replays_applicable": {"type": "boolean"},
              "cpu_q8_roundtrip_self_check": {"$ref": "#/$defs/q8_comparison"},
              "effective_q8_propagation": {
                "type": ["object", "null"],
                "required": ["chain_vs_cpu", "activation_only_vs_cpu", "cpu_down_with_chain_effective_input", "gpu_down_vs_same_effective_cpu_input"],
                "properties": {
                  "chain_vs_cpu": {"$ref": "#/$defs/q8_comparison"},
                  "activation_only_vs_cpu": {"$ref": "#/$defs/q8_comparison"},
                  "cpu_down_with_chain_effective_input": {"$ref": "#/$defs/comparison"},
                  "cpu_down_with_same_input_activation": {"$ref": "#/$defs/comparison"},
                  "gpu_down_vs_same_effective_cpu_input": {"$ref": "#/$defs/comparison"}
                }
              },
              "chained_operator_checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/comparison"}},
              "identical_input_replays": {"type": "array", "minItems": 9, "maxItems": 12, "items": {"$ref": "#/$defs/comparison"}}
            }
          }
        }
      }
    },
    "activation_bytes": {"type": "integer", "minimum": 1},
    "weight_uploads_in_timing": {"type": "boolean"},
    "weight_upload_method": {"enum": ["none", "synchronous_pageable_source"]},
    "weight_upload_destination": {"enum": ["gpu", "cpu_self_test"]},
    "cuda_mmq_precision_override": {"type": ["string", "null"]},
    "hardware_gpu_partition": {"const": false},
    "partitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["gpu_experts", "cpu_experts", "split_index", "modes", "correctness", "pinned_staging_bytes", "cpu_partial_output_bytes"],
        "properties": {
          "gpu_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "cpu_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "expert_partition_scope": {"enum": ["whole_ffn", "down_projection_only"]},
          "cpu_gate_up_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "gpu_gate_up_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "cpu_down_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "gpu_down_experts": {"type": "integer", "minimum": 0, "maximum": 4},
          "activation_stage_copy_bytes_per_iteration": {"type": "integer", "minimum": 0, "maximum": 11796480},
          "split_index": {"type": "integer", "minimum": 0, "maximum": 4},
          "modes": {"type": "object", "required": ["serial"], "additionalProperties": {"$ref": "#/$defs/timing"}},
          "weight_upload_bytes_per_iteration": {"type": "integer", "minimum": 0},
          "pinned_staging_bytes": {"type": "integer", "minimum": 0, "maximum": 11796480},
          "cpu_partial_output_bytes": {"type": "integer", "minimum": 0, "maximum": 11796480},
          "correctness": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["passed", "max_abs_error", "relative_l2_error", "tolerance"],
              "properties": {"passed": {"type": "boolean"}}
            }
          }
        }
      }
    },
    "all_checks_passed": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"required": ["execution_split"], "properties": {"execution_split": {"const": "cpu_activation_gpu_down"}}},
      "then": {
        "required": ["cpu_activation_quantization", "activation_stage_copy_method", "activation_stage_copy_destination"],
        "properties": {
          "activation_stage_copy_method": {"const": "synchronous_tensor_copy"},
          "operator_diagnostics": {
            "properties": {
              "samples": {"items": {"required": ["cpu_activation_observer_control"]}}
            }
          },
          "partitions": {
            "items": {
              "required": ["expert_partition_scope", "cpu_gate_up_experts", "gpu_gate_up_experts", "cpu_down_experts", "gpu_down_experts", "activation_stage_copy_bytes_per_iteration"],
              "properties": {
                "expert_partition_scope": {"const": "down_projection_only"},
                "cpu_gate_up_experts": {"const": 4},
                "gpu_gate_up_experts": {"const": 0},
                "modes": {
                  "additionalProperties": {
                    "required": ["median_cpu_activation_prepare_ms", "median_activation_stage_copy_ms"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"required": ["operator_check_enabled"], "properties": {"operator_check_enabled": {"const": true}}},
      "then": {"required": ["operator_diagnostics", "timings_qualified"], "properties": {"timings_qualified": {"const": false}}}
    }
  ]
}
